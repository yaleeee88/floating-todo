{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "悬浮待办",
  "version": "0.5.1",
  "identifier": "com.gaopengfei.floating-todo",
  "build": {
    "frontendDist": "../src",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "悬浮待办",
        "label": "main",
        "width": 390,
        "height": 650,
        "minWidth": 250,
        "minHeight": 180,
        "maxWidth": 960,
        "maxHeight": 860,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false,
        "generalAutofillEnabled": false,
        "browserExtensionsEnabled": false,
        "devtools": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
